k4forge.org {
    root * /var/www/k4forge
    file_server

    # SPA fallback: serve index.html for missing files
    try_files {path} {path}/ /index.html

    # Cache static assets aggressively
    @static path *.js *.css *.png *.jpg *.svg *.ico *.woff2
    header @static Cache-Control "public, max-age=31536000, immutable"

    # Cache JSON demo artifacts for 1 hour
    @json path /demo/*.json
    header @json Cache-Control "public, max-age=3600"

    # Security headers
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
    }

    # Gzip
    encode gzip

    log {
        output file /var/log/caddy/k4forge.log
    }
}
